# ── SoundCloud ───────────────────────────────────────────────────────────────
# Get credentials at: https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=your_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_client_secret_here

# The SoundCloud permalink of the DJ (the part after soundcloud.com/)
SOUNDCLOUD_USER_PERMALINK=splintr

# ── YouTube ───────────────────────────────────────────────────────────────────
# Create your key at: https://console.cloud.google.com
# → APIs & Services → Enable APIs → YouTube Data API v3
# → Credentials → Create Credentials → API Key
YOUTUBE_API_KEY=your_google_api_key_here
YOUTUBE_CHANNEL_HANDLE=gersebeats
