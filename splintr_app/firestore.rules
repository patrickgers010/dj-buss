rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data != null;
    }

    // ── Users ─────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Events ────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;  // Public — anyone can view events
      allow write: if isAdmin();
    }

    // ── Ticket Types ──────────────────────────────────────────
    match /ticketTypes/{ticketTypeId} {
      allow read: if true;  // Public — anyone can view ticket info
      allow write: if isAdmin();
    }

    // ── Purchased Tickets ─────────────────────────────────────
    match /purchasedTickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;  // Only created by Cloud Functions after payment
      allow update: if isAdmin();  // Admin can mark as used
      allow delete: if false;
    }

    // ── Posts (Community feed) ─────────────────────────────────
    match /posts/{postId} {
      allow read: if true;  // Public feed
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.authorId) || isAdmin();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      // Post likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // Post comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update: if isOwner(resource.data.authorId);
        allow delete: if isOwner(resource.data.authorId) || isAdmin();
      }
    }

    // ── Artists ────────────────────────────────────────────────
    match /artists/{artistId} {
      allow read: if true;  // Public
      allow write: if isAdmin();
    }

    // ── Admins ────────────────────────────────────────────────
    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;  // Only set manually in Firebase Console
    }

    // ── Stripe customers (mapping userId → Stripe customer ID) ─
    match /stripeCustomers/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;  // Only Cloud Functions
    }

    // ── Notifications ─────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;  // Only Cloud Functions
    }
  }
}
