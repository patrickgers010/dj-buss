rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // 5MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Post media (images/videos)
    match /posts/{postId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024  // 50MB max for videos
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
    }

    // Event images (admin only — validated by Cloud Functions)
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if false;  // Only via admin SDK in Cloud Functions
    }

    // Artist images (admin only)
    match /artists/{artistId}/{fileName} {
      allow read: if true;
      allow write: if false;  // Only via admin SDK
    }
  }
}
